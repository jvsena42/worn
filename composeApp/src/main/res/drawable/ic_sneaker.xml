<!--
  Side-profile sneaker, replacing the previous "footprints" icon.

  Footprints read as walking or tracking rather than as an item of clothing, and its six thin
  disconnected strokes dissolved at the 18dp the category tiles and chips render at. This is one
  closed silhouette plus a single sole line, which survives that size.

  Stroke style matches the other category icons (2dp, round cap and join, transparent fill) so it
  sits correctly next to ic_shirt / ic_wind / ic_glasses. The stroke colour is a placeholder — every
  call site tints it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Heel, collar, instep, vamp, toe box, sole. -->
    <path
        android:pathData="M2.5,17 L2.5,9.5 A1.5,1.5,0,0,1,4,8 L6.3,8 L10.3,11.8 L16,13.2 C19.3,14,21.5,14.9,21.5,16 A1,1,0,0,1,20.5,17 Z"
        android:strokeWidth="2"
        android:strokeColor="#000000"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="@android:color/transparent" />
    <!-- Sole seam. Stops short of the toe so it meets the outline rather than crossing it. -->
    <path
        android:pathData="M2.5,14.7 L19.4,14.7"
        android:strokeWidth="2"
        android:strokeColor="#000000"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="@android:color/transparent" />
</vector>
