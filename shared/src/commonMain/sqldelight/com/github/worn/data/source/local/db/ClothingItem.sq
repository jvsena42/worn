import kotlin.String;
import kotlin.collections.List;

CREATE TABLE clothingItem (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    category TEXT NOT NULL,
    colors TEXT AS List<String> NOT NULL DEFAULT '',
    seasons TEXT AS List<String> NOT NULL DEFAULT '',
    tags TEXT AS List<String> NOT NULL DEFAULT '',
    description TEXT,
    subcategory TEXT,
    fit TEXT,
    material TEXT,
    photoPath TEXT NOT NULL,
    createdAt INTEGER NOT NULL
);

getAll:
SELECT * FROM clothingItem ORDER BY createdAt DESC;

getById:
SELECT * FROM clothingItem WHERE id = ?;

-- Only the columns needed to label a set of items, so building an outfit's default name is one
-- query instead of one full row read per item. Never call with an empty collection: SQLDelight
-- expands `IN ?` to `IN ()`, which SQLite rejects.
getNamesByIds:
SELECT id, name FROM clothingItem WHERE id IN ?;

getByCategory:
SELECT * FROM clothingItem WHERE category = ?
ORDER BY createdAt DESC;

search:
SELECT * FROM clothingItem
WHERE name LIKE :query OR description LIKE :query
ORDER BY createdAt DESC;

insert:
INSERT INTO clothingItem(id, name, category, colors, seasons, tags, description, subcategory, fit, material, photoPath, createdAt)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

update:
UPDATE clothingItem
SET name = ?, category = ?, colors = ?, seasons = ?, tags = ?, description = ?,
    subcategory = ?, fit = ?, material = ?, photoPath = ?
WHERE id = ?;

delete:
DELETE FROM clothingItem WHERE id = ?;
